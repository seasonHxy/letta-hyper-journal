# 复制为 .env 并填入你的智谱 key： cp .env.example .env
# 智谱开放平台 key：https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY=你的智谱key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：聊天模型。默认 glm-4.6（agentic 任务推荐）。免费但较弱可设 glm-4-flash
# LLM_MODEL=glm-4-flash

# 你的 Letta server 地址（需先自部署一个 Letta server，见 README）
LETTA_BASE_URL=http://localhost:8283
